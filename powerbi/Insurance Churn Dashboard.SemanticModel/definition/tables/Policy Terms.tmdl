table 'Policy Terms'
	lineageTag: 7bac8c6c-eb7a-4b74-9bf4-979197a37a4b

	measure 'Total Terms' = COUNTROWS('Policy Terms')
		formatString: #,0
		lineageTag: 4148638d-3835-487a-b2ac-b91a9b062545

	measure 'Cancelled Terms' = SUM('Policy Terms'[Churned])
		formatString: #,0
		lineageTag: d6d6d571-e080-4c5f-a515-a428600cadcc

	measure 'Churn Rate' = DIVIDE([Cancelled Terms], [Total Terms])
		formatString: 0.0%
		lineageTag: 21a5e275-2d95-43dd-aba0-dcddfb4b7115

	measure 'Churn Rate (Model Test Period)' = CALCULATE([Churn Rate], 'Policy Terms'[Term_Start] >= DATE(2024, 1, 1), 'Policy Terms'[Term_Start] < DATE(2024, 10, 1))
		formatString: 0.0%
		lineageTag: 910577be-df8e-4559-bb48-2ee27c85892c

	measure 'Churn Rate (100+ terms)' = IF([Total Terms] >= 100, [Churn Rate])
		formatString: 0.0%
		lineageTag: 3cc154e6-54b5-45c9-9e2c-52dab8336ab2

	measure 'Renewal Cancel Rate' = DIVIDE(SUM('Policy Terms'[CAN_REN]), [Total Terms])
		formatString: 0.0%
		lineageTag: 9e44b36a-14f6-452f-9b60-19483d589a17

	measure 'Mid-term Cancel Rate' = DIVIDE(SUM('Policy Terms'[CAN_MT]), [Total Terms])
		formatString: 0.0%
		lineageTag: 6b5cf35c-f5a7-4f4e-a0dd-22785ff5f82e

	measure 'Premium Lost' = CALCULATE(SUM('Policy Terms'[Term_Premium]), 'Policy Terms'[Churned] = 1, 'Policy Terms'[Premium_Outlier] = 0)
		formatString: $#,0
		lineageTag: c587a67c-bafd-4d50-a972-73af85d71455

	measure 'Avg Risk Score' = AVERAGE('Policy Terms'[Risk_Score])
		formatString: 0.0%
		lineageTag: 93777ed8-4d99-4b9c-9599-90f2f7e1c622

	measure 'Active Terms' = CALCULATE([Total Terms], 'Policy Terms'[Is_Active_2025] = 1)
		formatString: #,0
		lineageTag: 90053146-395b-4df6-a381-7e5a07b3d796

	measure 'High-Risk Active Terms' = CALCULATE([Total Terms], 'Policy Terms'[Is_Active_2025] = 1, 'Policy Terms'[Risk_Tier] = "High")
		formatString: #,0
		lineageTag: 62e374bc-5bf5-4b56-8868-e3f15341cd21

	measure 'High-Risk Active Premium' = CALCULATE(SUM('Policy Terms'[Term_Premium]), 'Policy Terms'[Is_Active_2025] = 1, 'Policy Terms'[Risk_Tier] = "High", 'Policy Terms'[Premium_Outlier] = 0)
		formatString: $#,0
		lineageTag: ce3715ea-bbe2-4ce1-bacc-8e2972c7f8ca

	measure 'Priority Segment Share of Cancellations' = DIVIDE(CALCULATE([Cancelled Terms], 'Policy Terms'[Priority_Segment] = 1), CALCULATE([Cancelled Terms], ALL('Policy Terms'[Priority_Segment])))
		formatString: 0.0%
		lineageTag: d4fb77db-6dfe-4cfc-b59c-4118c0d5d7ad

	measure 'Bar Color' = IF((ISINSCOPE('Policy Terms'[Province_Group]) && SELECTEDVALUE('Policy Terms'[Province_Group]) = "NB") || (ISINSCOPE('Policy Terms'[Carrier_Group]) && SELECTEDVALUE('Policy Terms'[Carrier_Group]) = "Carrier 65575") || (ISINSCOPE('Policy Terms'[Tenure_Band]) && SELECTEDVALUE('Policy Terms'[Tenure_Band]) IN {"1-3 yrs", "3-5 yrs"}) || (ISINSCOPE('Policy Terms'[Bundled]) && SELECTEDVALUE('Policy Terms'[Bundled]) = "Single line") || (ISINSCOPE('Policy Terms'[LOB_Name]) && SELECTEDVALUE('Policy Terms'[LOB_Name]) IN {"Tenant package", "Auto"}) || (ISINSCOPE('Policy Terms'[Premium_Quartile]) && SELECTEDVALUE('Policy Terms'[Premium_Quartile]) = "Q4 (highest)") || (ISINSCOPE('Policy Terms'[Test_Risk_Tier]) && SELECTEDVALUE('Policy Terms'[Test_Risk_Tier]) = "High"), "#2E6F95", "#BFBFBF")
		lineageTag: ba4f8d89-d609-42d1-9133-37e0e942d305

	measure 'Heat Color' = VAR r = [Churn Rate (100+ terms)] RETURN SWITCH(TRUE(), ISBLANK(r), "#FFFFFF", r >= 0.40, "#7FA7C4", r >= 0.25, "#C9DAE7", "#FFFFFF")
		lineageTag: e8667047-32a6-4766-b3f1-f81ce3a18394

	measure 'Ctx Terms' = FORMAT(DISTINCTCOUNT('Policy Terms'[Client_id]), "#,0") & " clients, " & DISTINCTCOUNT('Policy Terms'[Carrier]) & " carriers"
		lineageTag: 820cc805-da9c-4591-a534-297c5ba856e6

	measure 'Ctx Churn' = "2023 terms (fully observed): " & FORMAT(CALCULATE([Churn Rate], 'Policy Terms'[Start_Year] = 2023), "0.0%")
		lineageTag: 275b7da6-5936-4d27-902e-ea0bbf2b6cff

	measure 'Ctx Renewal' = FORMAT(DIVIDE(SUM('Policy Terms'[CAN_REN]), [Cancelled Terms]), "0%") & " of all cancellations"
		lineageTag: decd75f1-6150-47d6-9499-d7614af85445

	measure 'Ctx Midterm' = FORMAT(DIVIDE(SUM('Policy Terms'[CAN_MT]), [Cancelled Terms]), "0%") & " of all cancellations"
		lineageTag: 8674c74a-dae7-4e99-88aa-245b73120bef

	measure 'Ctx Premium' = "Avg " & FORMAT(DIVIDE([Premium Lost], CALCULATE([Cancelled Terms], 'Policy Terms'[Premium_Outlier] = 0)), "$#,0") & " per cancelled term"
		lineageTag: 9d670a19-ee83-412a-a5cd-6a1c85acd761

	measure 'Ctx Active' = "Terms that started in 2025 and are still active"
		lineageTag: 27db0d0e-10a2-4da6-8153-513908f720d7

	measure 'Ctx High Risk' = FORMAT(DIVIDE([High-Risk Active Terms], [Active Terms]), "0%") & " of active terms"
		lineageTag: 8ce8d55b-bcff-4c0a-9769-a264528fc79a

	measure 'Ctx High Risk Premium' = "Premium at stake if these clients leave"
		lineageTag: d504262c-1acb-4710-a308-281e3d0aaa6f

	measure 'Ctx Priority' = "Single-line auto clients, up to 5 years tenure"
		lineageTag: 8faf8c14-e8ad-4ccf-b3c9-130cd5d69426

