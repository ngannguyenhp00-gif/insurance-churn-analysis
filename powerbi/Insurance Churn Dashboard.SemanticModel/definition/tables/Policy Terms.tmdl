	partition 'Policy Terms' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "policy_terms.csv"), [Delimiter=",", Columns=27, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Policy_Term_id", Int64.Type}, {"Client_id", Int64.Type}, {"Carrier", type text}, {"Province", type text}, {"Line_of_Business", type text}, {"LOB_Group", type text}, {"Bundled", type text}, {"Province_Group", type text}, {"LOB_Display", type text}, {"LOB_Name", type text}, {"Carrier_Group", type text}, {"Tenure_Band", type text}, {"Tenure_Order", Int64.Type}, {"Premium_Quartile", type text}, {"Term_Start", type date}, {"Start_Year", Int64.Type}, {"Term_Premium", type number}, {"Premium_Outlier", Int64.Type}, {"CAN_REN", Int64.Type}, {"CAN_MT", Int64.Type}, {"Churned", Int64.Type}, {"Risk_Score", type number}, {"Risk_Tier", type text}, {"Risk_Tier_Order", Int64.Type}, {"Test_Risk_Tier", type text}, {"Is_Active_2025", Int64.Type}, {"Priority_Segment", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

